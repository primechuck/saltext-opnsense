# Example pillar top.sls addition for jrbob proxy minion
#
# Add to infra/salt/pillars/top.sls (or projects/saltext-opnsense/examples/top)
# This shows how master assigns pillar to proxy minion id `jrbob`.
#
# The proxy minion process runs with --proxyid=jrbob, so master matches it
# via minion id targeting (not grains). File-based /etc/salt/proxy can also
# work alone without this, but pillar is preferred for secrets.

base:
  # All minions still get common
  '*':
    - common

  # sparky master itself needs opnsense pillar for direct mode (optional)
  # Direct mode = `salt sparky opnsense.call ...` without proxy
  'sparky':
    - hosts.sparky
    # Uncomment if you want direct API access from master pillar `opnsense:`
    # - hosts.jrbob   # contains opnsense: host/key/secret + aliases

  # Proxy minion id jrbob — master provides proxy: dict
  'jrbob':
    - match: list
    - hosts.jrbob

# Notes:
# - If using file-based /etc/salt/proxy on sparky host, the above `jrbob`
#   entry is still useful for CMDB data (aliases, bind_zone, cluster_parent)
#   but proxy credentials come from file, not pillar.
# - Vault integration: hosts/jrbob.sls uses __slot__:salt:vault.read(...)
#   Those slots are rendered on master, so secret never appears plaintext
#   in pillar file — only resolved during pillar compilation.
# - For local testing without master, you can skip top.sls entirely and just
#   use /etc/salt/proxy flat file.
