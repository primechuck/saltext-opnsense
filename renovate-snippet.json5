//     "cd projects/saltext-opnsense && python tools/generate_spec.py --core-ref $(jq -r '.meta.core_ref' src/saltext/opnsense/utils/controllers.json) --plugins-ref $(jq -r '.meta.plugins_ref' src/saltext/opnsense/utils/controllers.json) --output src/saltext/opnsense/utils/controllers.json && cp src/saltext/opnsense/utils/controllers.json tools/controllers.json"
//   ],
